# ----------------------------------------------------------------------
# Auto-detect text files and perform LF normalization
# ----------------------------------------------------------------------
* text=auto

# ----------------------------------------------------------------------
# Source Code (Kotlin, Java, Rust)
# ----------------------------------------------------------------------
*.kt text eol=lf
*.java text eol=lf
*.rs text eol=lf

# ----------------------------------------------------------------------
# Configuration and Documentation (TOML, YAML, Markdown)
# ----------------------------------------------------------------------
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf

# ----------------------------------------------------------------------
# Scripts
# ----------------------------------------------------------------------
# Shell scripts must always use LF, otherwise they fail on Unix/Linux/macOS
*.sh text eol=lf

# Windows scripts (Batch, PowerShell) usually prefer CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ----------------------------------------------------------------------
# Build scripts
# ----------------------------------------------------------------------
*.gradle text eol=lf
*.kts text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# ----------------------------------------------------------------------
# Binary Files
# ----------------------------------------------------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.so binary
*.dll binary
*.dylib binary
*.jks binary
*.keystore binary
*.apk binary
*.aab binary
*.jar binary
